<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical">

        <com.sergioasenjo.vesperhome.applications.AppRowView
            android:id="@+id/applicationsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/hdmiInputsSection"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:layout_marginEnd="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hdmiInputOne"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="@color/hdmi_input_card_background"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/action_button_text"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_input"
                app:iconPadding="8dp"
                app:iconSize="16dp"
                app:iconTint="@color/action_button_text"
                app:strokeColor="@color/hdmi_input_card_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hdmiInputTwo"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="@color/hdmi_input_card_background"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/action_button_text"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_input"
                app:iconPadding="8dp"
                app:iconSize="16dp"
                app:iconTint="@color/action_button_text"
                app:strokeColor="@color/hdmi_input_card_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hdmiInputThree"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="@color/hdmi_input_card_background"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textColor="@color/action_button_text"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_input"
                app:iconPadding="8dp"
                app:iconSize="16dp"
                app:iconTint="@color/action_button_text"
                app:strokeColor="@color/hdmi_input_card_stroke"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/showsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="@dimen/launcher_section_gap"
            android:clipChildren="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/accent_tick" />

                <TextView
                    android:id="@+id/showsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.14"
                    android:text="@string/shows"
                    android:textAllCaps="true"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/showsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/accent"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/showsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/jellyfin_series_empty"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/showsItems"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="@dimen/launcher_section_content_gap"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

        </LinearLayout>

        <com.sergioasenjo.vesperhome.applications.AppRowView
            android:id="@+id/favoriteRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/categoryRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
